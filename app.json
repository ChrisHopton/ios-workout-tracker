{
  "expo": {
    "name": "Workout",
    "slug": "workout-personal",
    "version": "1.0.0",
    "scheme": "workout",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chopton.workout.personal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "deploymentTarget": "16.4"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ],
      "expo-document-picker",
      "expo-sharing",
      "expo-secure-store"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}

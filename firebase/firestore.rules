rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profile reset fence: enrollment v3, record envelope v2; legacy paths remain denied.
    function uuid(value) {
      return value is string && value.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}');
    }
    function record(deviceId, generationId, key) {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'deviceId', 'generationId', 'installationId', 'key', 'kind', 'revision', 'deleted', 'payload'])
        && data.keys().hasOnly(['schemaVersion', 'deviceId', 'generationId', 'installationId', 'key', 'kind', 'revision', 'deleted', 'payload'])
        && data.schemaVersion == 2 && data.deviceId == deviceId && data.generationId == generationId
        && uuid(deviceId) && uuid(generationId) && uuid(data.installationId)
        && data.key == key && key.size() > 0 && key.size() <= 1500
        && data.kind in ['profile', 'body_weight', 'exercise', 'plan', 'schedule', 'schedule_template', 'workout', 'workout_exercise', 'schedule_progress', 'completion']
        && data.revision is int && data.revision > 0 && data.revision <= 9007199254740991
        && data.deleted is bool && data.payload is map
        && (data.deleted == false || data.payload.size() == 0)
        && ((data.kind == 'completion' && key == 'completion' && data.deleted == false
             && data.payload.keys().hasOnly(['initialUploadComplete']) && data.payload.initialUploadComplete == true)
            || (data.kind != 'completion' && key.matches(data.kind + ':' + deviceId + ':.+')));
    }
    function automaticOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function automaticBinding() {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'enabled', 'deviceId', 'generationId', 'installationId'])
        && data.keys().hasOnly(['schemaVersion', 'enabled', 'deviceId', 'generationId', 'installationId'])
        && data.schemaVersion == 3 && data.enabled == true
        && uuid(data.deviceId) && uuid(data.generationId) && uuid(data.installationId);
    }
    function automaticRecord(uid, key) {
      let enrollment = get(/databases/$(database)/documents/automaticUploads/$(uid)).data;
      return enrollment.schemaVersion == 3 && enrollment.enabled == true
        && enrollment.installationId == request.resource.data.installationId
        && record(enrollment.deviceId, enrollment.generationId, key);
    }
    match /automaticUploads/{uid} {
      // App Check is enforced by the Firestore service. Only owner tooling may open this gate.
      allow create: if automaticOwner(uid)
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && get(/databases/$(database)/documents/uploadControl/automaticEnrollment).data.enabled == true
        && automaticBinding();
      allow update: if automaticOwner(uid) && resource.data.enabled == true
        && automaticBinding() && request.resource.data == resource.data;
      allow read, delete: if false;
      match /records/{key} {
        allow create: if automaticOwner(uid) && automaticRecord(uid, key);
        allow update: if automaticOwner(uid) && automaticRecord(uid, key)
          && (request.resource.data.revision > resource.data.revision || request.resource.data == resource.data);
        allow read, delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

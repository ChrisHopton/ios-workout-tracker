{
  "name": "workoutapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "expo": "57.0.29",
    "expo-constants": "57.0.22",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "57.0.20",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.27",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.23",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "firebase-admin": "13.7.0",
    "firebase": "12.10.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase-tools": "15.33.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "export:ios": "expo export --platform ios",
    "build:ios": "npx eas-cli@latest build --platform ios --profile preview",
    "measure": "tsx scripts/measure.ts",
    "firebase:setup": "tsx scripts/firebaseSetup.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-workout-sync \"tsx --test tests/firestoreRules.test.ts\"",
    "firebase:deploy": "firebase deploy --only firestore"
  },
  "private": true,
  "overrides": {
    "@firebase/app": "0.14.9",
    "@firebase/app-compat": "0.5.9",
    "@firebase/database-compat": "2.1.1"
  }
}

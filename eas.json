{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "24.12.0"
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "ios": {
        "simulator": false
      },
      "channel": "preview",
      "environment": "preview",
      "node": "24.12.0"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "24.12.0"
    }
  }
}
